<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>StoreChase</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.11.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <!-- The harness lives under the repo root but is its own project with its
         own entry point. Without this the default **/*.cs glob would compile
         the harness's Program.cs into the game as well, which collides with
         the game's top-level statements (CS7022). -->
    <Compile Remove="harness\**\*.cs" />
    <None Include="harness\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cat model files are loaded at runtime by ObjLoader.cs, not
         through the MGCB content pipeline (see ObjLoader.cs for why).
         Because of that, MSBuild has no reason to know about them unless
         told explicitly — this copies them to the output directory
         alongside the compiled game so File.ReadLines/File.OpenRead in
         ObjLoader can find them at their expected relative path. -->
    <None Include="Content\Models\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
